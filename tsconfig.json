{
  "compilerOptions": {
    /* Language and environment */
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "useDefineForClassFields": true,

    /* Modules — bundler resolution, Vite does the actual bundling */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    /* Emit — type-checking only, Vite/esbuild emits */
    "noEmit": true,
    "skipLibCheck": true,

    /* Strictness — maximal */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,

    /* Feature-Sliced Design layer aliases — mirrored in vite.config.ts's
     * resolve.alias, since Vite/esbuild/Vitest do not read this field.
     * No baseUrl: paths without one resolve relative to this file. */
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@entities/*": ["./src/entities/*"],
      "@features/*": ["./src/features/*"],
      "@widgets/*": ["./src/widgets/*"],
      "@pages/*": ["./src/pages/*"],
      "@app/*": ["./src/app/*"],
      "@game/*": ["./src/game/*"],
      "@i18n/*": ["./src/i18n/*"]
    }
  },
  "include": ["src", "e2e", "*.config.ts", "public/*.d.ts"]
}
