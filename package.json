{
  "name": "elevator-saga",
  "version": "2.0.0",
  "description": "Elevator Saga - the elevator programming game. Write JavaScript to transport people efficiently.",
  "keywords": [
    "elevator",
    "elevator-saga",
    "programming-game",
    "game",
    "puzzle",
    "javascript",
    "typescript",
    "browser-game",
    "simulation",
    "learning"
  ],
  "homepage": "https://github.com/EpicDima/elevatorsaga#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EpicDima/elevatorsaga.git"
  },
  "bugs": {
    "url": "https://github.com/EpicDima/elevatorsaga/issues"
  },
  "license": "MIT",
  "author": "EpicDima (https://github.com/EpicDima)",
  "contributors": [
    "Magnus Wolffelt (https://github.com/magwo)",
    "The Elevator Saga contributors (https://github.com/magwo/elevatorsaga/graphs/contributors)"
  ],
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "bench": "node src/cli/bench.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "screenshot": "playwright test --config playwright.screenshot.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@fontsource/oswald": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/javascript": "^1.5.4",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
