{
  "name": "elevator-saga",
  "version": "2.0.0",
  "description": "Elevator Saga, redesigned: write JavaScript to move people through a building efficiently.",
  "keywords": [
    "elevator",
    "elevator-saga",
    "programming-game",
    "game",
    "puzzle",
    "javascript",
    "typescript",
    "browser-game",
    "simulation",
    "learning"
  ],
  "homepage": "https://elevatorsaga.epicdima.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EpicDima/elevatorsaga.git"
  },
  "bugs": {
    "url": "https://github.com/EpicDima/elevatorsaga/issues"
  },
  "license": "MIT",
  "author": "EpicDima (https://github.com/EpicDima)",
  "contributors": [
    "Magnus Wolffelt (https://github.com/magwo)",
    "The Elevator Saga contributors (https://github.com/magwo/elevatorsaga/graphs/contributors)"
  ],
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "imports": {
    "#shared/*": "./src/shared/*",
    "#entities/*": "./src/entities/*",
    "#features/*": "./src/features/*",
    "#widgets/*": "./src/widgets/*",
    "#pages/*": "./src/pages/*",
    "#app/*": "./src/app/*",
    "#game/*": "./src/game/*",
    "#i18n/*": "./src/i18n/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "bench": "node src/cli/bench.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "screenshot": "playwright test --config playwright.screenshot.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@lezer/javascript": "1.5.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
