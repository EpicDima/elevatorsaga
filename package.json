{
  "name": "elevator-saga",
  "version": "2.0.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Elevator Saga - the elevator programming game. Write JavaScript to transport people efficiently.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EpicDima/elevatorsaga.git"
  },
  "homepage": "https://github.com/EpicDima/elevatorsaga",
  "bugs": {
    "url": "https://github.com/EpicDima/elevatorsaga/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@fontsource/oswald": "^5.3.0",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
